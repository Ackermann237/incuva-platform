# Copier ce fichier en ".env" et renseigner les valeurs. Ne JAMAIS versionner le vrai ".env".

# Clé de session Flask (optionnel : sinon générée et conservée dans .secret_key)
SECRET_KEY=

# Firebase (config web du projet, identique au frontend). FIREBASE_API_KEY sert à vérifier les mots de passe.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Envoi des emails (codes de vérification)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# IA
HUGGINGFACE_API_KEY=
# Modèle de l'assistant Jarvis (facultatif, par défaut meta-llama/Llama-3.1-8B-Instruct:novita)
JARVIS_MODEL=
ASSEMBLYAI_API_KEY=

# Stockage des CV (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

# Visioconférence (Agora)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# NB : le compte de service Firebase (fichier JSON) se place dans app/firebase/incuva_cred.json.
# Ce fichier contient une clé privée : il ne doit JAMAIS être versionné (il est dans le .gitignore).
